# DeepSeek 大模型 API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# 模型成本估算（可选，按供应商当前价格填写：美元/百万Token）
MODEL_INPUT_COST_PER_MILLION=
MODEL_OUTPUT_COST_PER_MILLION=

# 飞书应用凭证（在 open.feishu.cn/app 获取）
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret

# 飞书每日简报表
DAILY_BASE_TOKEN=your_daily_base_token
DAILY_TABLE_ID=your_daily_table_id

# 飞书信息点配置表
INFO_BASE_TOKEN=your_info_base_token
INFO_TABLE_ID=your_info_table_id

# 飞书群机器人
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# Skill运行监控卡片专用飞书机器人（可选；不填则只生成本地报告）
MONITORING_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# Skill运行监控（可选，以下为默认值）
MONITORING_DB_PATH=data/monitoring.sqlite3
MONITORING_REPORT_DIR=data/monitoring
SKILL_ENVIRONMENT=production
SKILL_VERSION=1.5

# 第四阶段：用户价值看板与维护（正式发布前设置高强度随机密钥）
SHU_SIGNAL_SITE_URL=https://shu-signal-intelligence.yuntingnian834.chatgpt.site
MONITORING_ADMIN_KEY=replace_with_a_long_random_secret
USER_VALUE_REPORT_DIR=data/monitoring/user_value

# 第五阶段：网站数据新鲜度与每日快照
FRESHNESS_REPORT_DIR=data/monitoring/freshness

# 百度翻译 API（可选）
BAIDU_TRANSLATE_APPID=your_appid
BAIDU_TRANSLATE_KEY=your_key
